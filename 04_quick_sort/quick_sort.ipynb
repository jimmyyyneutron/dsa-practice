   "outputs": [],
   "source": [
    "def quick_sort(arr):\n",
    "    if len(arr) < 2:\n",
    "        return arr\n",
    "    pivot = arr[0]\n",
    "    lower = [i for i in arr[1:] if i <= pivot]\n",
    "    higher = [i for i in arr[1:] if i > pivot]\n",
    "    return quick_sort(lower) + [pivot] + quick_sort(higher)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "d15a7d32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[2, 3, 5, 10]\n"
     ]
    }
   ],
   "source": [
    "print(quick_sort([10,5,2,3]))"
   ]
  }
